---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'UPN | Portal Curricular - Plan de Estudios 2023 (200 CR)',
  description = 'Portal Curricular interactivo, planificador de matrícula y árbol de prerrequisitos para Ingeniería de Sistemas Computacionales - Universidad Privada del Norte.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Academy Space | Portal Curricular - UPN</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-zinc-950 text-zinc-100 min-h-screen antialiased bg-grid-pattern">
    <slot />
  </body>
</html>
